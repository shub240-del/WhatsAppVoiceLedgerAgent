# Udhaar server environment. Copy to .env.local for local runs (never commit it).
# On Vercel, add these under Project → Settings → Environment Variables instead.
# Every value here is SERVER-ONLY: never prefix secrets with VITE_.

# --- Firebase Admin (required) ---
# Whole service-account JSON on one variable (Vercel), or use GOOGLE_APPLICATION_CREDENTIALS locally.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=udhar-khata-f41fb
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/outside-repo/service-account.json
# Exact frontend origin for CORS. On Vercel this defaults to the production domain.
ALLOWED_ORIGIN=

# --- Gnani speech-to-text (Prisma) ---
# Key from https://app.gnani.ai/voice  (sent as the X-API-Key-ID header; never logged)
GNANI_API_KEY=
# Optional (defaults shown):
# GNANI_STT_MODEL=prisma-v3.0           # or prisma-v2.5 (one language only)
# GNANI_STT_LANGUAGES=hi-IN,en-IN       # 1–4 of: bn-IN en-IN gu-IN hi-IN kn-IN ml-IN mr-IN pa-IN ta-IN te-IN
# GNANI_STT_FORMAT=verbatim             # verbatim | transcribe | codemix | transliterate (last two: v3.0)
# GNANI_BASE_URL=https://api.vachana.ai

# --- Gemini (EVON parser) ---
APP_GEMINI_API_KEY=
# Optional, default gemini-3.5-flash-lite (stable, fast, works on the free tier):
# APP_GEMINI_MODEL=gemini-3.5-flash-lite

# --- WhatsApp Cloud API (Meta) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# --- Same-tab Google sign-in on phones (optional, public, build-time) ---
# Phones open Google sign-in as a new tab. To keep it in the same tab, serve the auth handler
# from this site (vercel.json already proxies /__/auth to Firebase), then:
#   1. Google Cloud console > APIs & Services > Credentials > the "Web client" OAuth client >
#      Authorized redirect URIs: add https://<your-site>/__/auth/handler
#   2. Set VITE_AUTH_SAME_SITE=true in Vercel and redeploy.
# Leave unset until step 1 is done, or Google sign-in will show redirect_uri_mismatch.
VITE_AUTH_SAME_SITE=
