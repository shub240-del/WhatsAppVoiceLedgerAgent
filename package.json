{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:emulators": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "api": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "check:gnani-env": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/check-gnani-env.ts",
    "check:gemini-env": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/check-gemini-env.ts",
    "provision:owner": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/provision-owner.ts",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/worker.ts",
    "check:env": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/check-env.ts",
    "integrity:check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/check-integrity.ts",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "playwright test -c playwright.e2e.config.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-tools": "^15.35.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
