{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://udhar-khata-f41fb.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://udhar-khata-f41fb.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/:path*",
